# Copy this file to ".env" and fill in your own key.
# Never commit the real .env file to GitHub.

# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Which OpenAI chat model to use for all three LLM tasks.
OPENAI_MODEL=gpt-4o-mini

# Set to "true" to run the whole pipeline with a fake/mock LLM
# (no API key or internet needed). Useful for testing the workflow
# plumbing, folder structure and CSV report without spending API credits.
MOCK_LLM=false
